# Database (Neon — injected by Vercel Marketplace, or copy from Neon console)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:pass@host/db?sslmode=require

# Auth.js
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional: proxy preview OAuth through production
# AUTH_REDIRECT_PROXY_URL=https://your-production-domain.com
# AUTH_URL=https://your-production-domain.com

# Optional: Google AI Studio — Gemini receipt/expense parse (app runs without it)
GOOGLE_API_KEY=

# Vercel Blob (private store for receipt photos)
# On Vercel, connect a *private* Blob store to the project (OIDC + BLOB_STORE_ID).
# Locally or outside Vercel, set a read-write token from the Blob store.
BLOB_READ_WRITE_TOKEN=
